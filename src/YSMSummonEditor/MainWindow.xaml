<Window x:Class="YSMSummonEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="YSM Summon Editor"
        Width="1560"
        Height="980"
        MinWidth="1260"
        MinHeight="820"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/Logo.ico"
        Background="{DynamicResource WindowBgBrush}">
    <Window.Resources>
        <Style x:Key="BaseDataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource RowOddBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{DynamicResource RowEvenBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RowSelectedBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DirtyDataGridRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource BaseDataGridRowStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RowDirtyBrush}" />
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RowSelectedBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CenteredDisplayTextStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="CenteredEditTextStyle" TargetType="TextBox">
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
    </Window.Resources>

    <Grid Margin="10" Background="{DynamicResource WindowBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10" Background="{DynamicResource WindowBgBrush}">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/Assets/Heaven_logo1.png"
                       Height="28"
                       Width="120"
                       Stretch="Uniform"
                       Margin="0,0,10,0" />
                <TextBlock VerticalAlignment="Center"
                           FontSize="22"
                           FontWeight="Bold"
                           Text="Summon Editor" />
                <TextBlock VerticalAlignment="Center"
                           Margin="8,6,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="made by YoSiem" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button x:Name="BtnSave" Width="108" Height="32" Margin="0,0,8,0" Content="Save" Click="BtnSave_Click" />
                <Button x:Name="BtnStats" Width="108" Height="32" Margin="0,0,8,0" Content="Stats" Click="BtnStats_Click" IsEnabled="False" />
                <ToggleButton x:Name="TglSaveMode"
                              Width="138"
                              Height="32"
                              Margin="0,0,8,0"
                              Content="Mode: DB"
                              ToolTip="Toggle save target: Database or .sql file."
                              Checked="TglSaveMode_Checked"
                              Unchecked="TglSaveMode_Unchecked" />
                <Button x:Name="BtnSettings" Width="108" Height="32" Content="Settings" Click="BtnSettings_Click" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Background="{DynamicResource PanelBgBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtSearch" Height="30" Margin="0,0,8,0" VerticalContentAlignment="Center" ToolTip="Search by summon ID/name/card." KeyDown="TxtSearch_KeyDown" />
                        <Button Grid.Column="1" Width="68" Height="30" Content="Go" Click="BtnSearch_Click" />
                    </Grid>

                    <ListView x:Name="ListSummons" Grid.Row="1" SelectionChanged="ListSummons_SelectionChanged" AlternationCount="2">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2" ToolTip="{Binding ToolTipText}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" VerticalAlignment="Center" HorizontalAlignment="Center" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                                        <Image Source="{Binding Icon}" Width="36" Height="36" Stretch="Fill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Summon.SummonName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Opacity="0.8" FontSize="12" Text="{Binding Summon.SummonId}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="0,0,0,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Background="{DynamicResource PanelBgBrush}" MinHeight="360">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="0,0,12,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="36" Height="36" Margin="0,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Center" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                                    <Image x:Name="ImgSummonHeaderIcon" Width="36" Height="36" Stretch="Fill" />
                                </Border>
                                <TextBlock x:Name="TxtSummonHeader" FontSize="26" FontWeight="Bold" Text="No selection" ToolTip="Selected final evolution summon." VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock x:Name="TxtSummonFeature" Grid.Row="1" Margin="0,8,0,0" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" ToolTip="Summon feature description." />

                            <TextBlock x:Name="TxtSummonMeta" Grid.Row="2" Margin="0,8,0,0" Foreground="{DynamicResource TextMutedBrush}" ToolTip="Card and basic metadata." />

                            <StackPanel Grid.Row="3" Margin="0,10,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel x:Name="ChainEvo1Panel" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Border Width="36" Height="36" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" HorizontalAlignment="Center">
                                        <Image x:Name="ImgChainEvo1" Width="36" Height="36" Stretch="Fill" />
                                    </Border>
                                    <TextBlock x:Name="TxtChainEvo1Id" Margin="0,4,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>

                                <TextBlock x:Name="TxtChainArrow12" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="18" Text="→" />

                                <StackPanel x:Name="ChainEvo2Panel" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Border Width="36" Height="36" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" HorizontalAlignment="Center">
                                        <Image x:Name="ImgChainEvo2" Width="36" Height="36" Stretch="Fill" />
                                    </Border>
                                    <TextBlock x:Name="TxtChainEvo2Id" Margin="0,4,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>

                                <TextBlock x:Name="TxtChainArrow23" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="18" Text="→" />

                                <StackPanel x:Name="ChainEvo3Panel" VerticalAlignment="Center">
                                    <Border Width="36" Height="36" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" HorizontalAlignment="Center">
                                        <Image x:Name="ImgChainEvo3" Width="36" Height="36" Stretch="Fill" />
                                    </Border>
                                    <TextBlock x:Name="TxtChainEvo3Id" Margin="0,4,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Column="1" Width="228" Height="328" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="4" Background="{DynamicResource PanelAltBrush}" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Grid>
                                <Image x:Name="ImgLarge" Width="220" Height="320" Stretch="Uniform" SnapsToDevicePixels="True" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TabControl x:Name="TabStages" Grid.Row="0" SelectionChanged="TabStages_SelectionChanged" />

                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="11*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="9*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" Background="{DynamicResource PanelBgBrush}">
                            <TabControl x:Name="TabTrees">
                                <TabControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Header}" ToolTip="{Binding HeaderToolTip}" />
                                    </DataTemplate>
                                </TabControl.ItemTemplate>
                                <TabControl.ContentTemplate>
                                    <DataTemplate>
                                        <DataGrid ItemsSource="{Binding CurrentEntries}"
                                                  SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserReorderColumns="False"
                                                  SelectionMode="Single"
                                                  IsReadOnly="False"
                                                  CellEditEnding="GridTree_CellEditEnding"
                                                  PreviewMouseRightButtonDown="GridTree_PreviewMouseRightButtonDown"
                                                  RowStyle="{StaticResource DirtyDataGridRowStyle}">
                                            <DataGrid.ContextMenu>
                                                <ContextMenu Opened="TreeContextMenu_Opened">
                                                    <MenuItem x:Name="MnuTreeAddRow" Header="Add Row" Click="MnuTreeAddRow_Click" />
                                                    <MenuItem x:Name="MnuTreeEditSkill" Header="Edit Skill" Click="MnuTreeEditSkill_Click" />
                                                    <MenuItem x:Name="MnuTreeDeleteRow" Header="Delete From Tree" Click="MnuTreeDeleteRow_Click" />
                                                </ContextMenu>
                                            </DataGrid.ContextMenu>
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="" Width="44" IsReadOnly="True">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Width="36" Height="36" VerticalAlignment="Center" HorizontalAlignment="Center" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                                                                <Border.ToolTip>
                                                                    <MultiBinding Converter="{StaticResource GameTooltipToToolTipConverter}">
                                                                        <Binding Path="SkillTooltipMarkup" />
                                                                        <Binding Path="SkillTooltipPlain" />
                                                                    </MultiBinding>
                                                                </Border.ToolTip>
                                                                <Image Source="{Binding SkillIcon}" Width="36" Height="36" Stretch="Fill" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="ID" Binding="{Binding SkillId, UpdateSourceTrigger=PropertyChanged}" Width="70" ElementStyle="{StaticResource CenteredDisplayTextStyle}" EditingElementStyle="{StaticResource CenteredEditTextStyle}" />
                                                <DataGridTemplateColumn Header="Skill" Width="210" IsReadOnly="True">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding SkillName}" Style="{StaticResource CenteredDisplayTextStyle}">
                                                                <TextBlock.ToolTip>
                                                                    <MultiBinding Converter="{StaticResource GameTooltipToToolTipConverter}">
                                                                        <Binding Path="SkillTooltipMarkup" />
                                                                        <Binding Path="SkillTooltipPlain" />
                                                                    </MultiBinding>
                                                                </TextBlock.ToolTip>
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="Grp" Binding="{Binding SkillGroupId, UpdateSourceTrigger=PropertyChanged}" Width="55" ElementStyle="{StaticResource CenteredDisplayTextStyle}" EditingElementStyle="{StaticResource CenteredEditTextStyle}" />
                                                <DataGridTextColumn Header="Min" Binding="{Binding MinSkillLv, UpdateSourceTrigger=PropertyChanged}" Width="55" ElementStyle="{StaticResource CenteredDisplayTextStyle}" EditingElementStyle="{StaticResource CenteredEditTextStyle}" />
                                                <DataGridTextColumn Header="Max" Binding="{Binding MaxSkillLv, UpdateSourceTrigger=PropertyChanged}" Width="55" ElementStyle="{StaticResource CenteredDisplayTextStyle}" EditingElementStyle="{StaticResource CenteredEditTextStyle}" />
                                                <DataGridTextColumn Header="Lv" Binding="{Binding Lv, UpdateSourceTrigger=PropertyChanged}" Width="52" ElementStyle="{StaticResource CenteredDisplayTextStyle}" EditingElementStyle="{StaticResource CenteredEditTextStyle}" />
                                                <DataGridTextColumn Header="Job" Binding="{Binding JobLv, UpdateSourceTrigger=PropertyChanged}" Width="55" ElementStyle="{StaticResource CenteredDisplayTextStyle}" EditingElementStyle="{StaticResource CenteredEditTextStyle}" />
                                                <DataGridTextColumn Header="N1" Binding="{Binding NeedSkillId1, UpdateSourceTrigger=PropertyChanged}" Width="55" ElementStyle="{StaticResource CenteredDisplayTextStyle}" EditingElementStyle="{StaticResource CenteredEditTextStyle}" />
                                                <DataGridTextColumn Header="N1 Lv" Binding="{Binding NeedSkillLv1, UpdateSourceTrigger=PropertyChanged}" Width="60" ElementStyle="{StaticResource CenteredDisplayTextStyle}" EditingElementStyle="{StaticResource CenteredEditTextStyle}" />
                                                <DataGridTextColumn Header="N2" Binding="{Binding NeedSkillId2, UpdateSourceTrigger=PropertyChanged}" Width="55" ElementStyle="{StaticResource CenteredDisplayTextStyle}" EditingElementStyle="{StaticResource CenteredEditTextStyle}" />
                                                <DataGridTextColumn Header="N2 Lv" Binding="{Binding NeedSkillLv2, UpdateSourceTrigger=PropertyChanged}" Width="60" ElementStyle="{StaticResource CenteredDisplayTextStyle}" EditingElementStyle="{StaticResource CenteredEditTextStyle}" />
                                                <DataGridTextColumn Header="N3" Binding="{Binding NeedSkillId3, UpdateSourceTrigger=PropertyChanged}" Width="55" ElementStyle="{StaticResource CenteredDisplayTextStyle}" EditingElementStyle="{StaticResource CenteredEditTextStyle}" />
                                                <DataGridTextColumn Header="N3 Lv" Binding="{Binding NeedSkillLv3, UpdateSourceTrigger=PropertyChanged}" Width="60" ElementStyle="{StaticResource CenteredDisplayTextStyle}" EditingElementStyle="{StaticResource CenteredEditTextStyle}" />
                                                <DataGridTextColumn Header="E Min" Binding="{Binding CEnhanceMin, UpdateSourceTrigger=PropertyChanged}" Width="62" ElementStyle="{StaticResource CenteredDisplayTextStyle}" EditingElementStyle="{StaticResource CenteredEditTextStyle}" />
                                                <DataGridTextColumn Header="E Max" Binding="{Binding CEnhanceMax, UpdateSourceTrigger=PropertyChanged}" Width="62" ElementStyle="{StaticResource CenteredDisplayTextStyle}" EditingElementStyle="{StaticResource CenteredEditTextStyle}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DataTemplate>
                                </TabControl.ContentTemplate>
                            </TabControl>
                        </Border>

                        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                        <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" Background="{DynamicResource PanelBgBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock FontWeight="SemiBold" FontSize="16" Text="Effective Skills" Margin="0,0,0,8" ToolTip="Merged by Skill ID + Lv for selected evolution stage." />

                                <DataGrid x:Name="GridEffective"
                                          Grid.Row="1"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserReorderColumns="False"
                                          SelectionMode="Single"
                                          IsReadOnly="False"
                                          RowStyle="{StaticResource DirtyDataGridRowStyle}"
                                          PreviewMouseRightButtonDown="GridEffective_PreviewMouseRightButtonDown"
                                          CellEditEnding="GridEffective_CellEditEnding">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu Opened="EffectiveContextMenu_Opened">
                                            <MenuItem x:Name="MnuEffectiveEditSkill" Header="Edit Skill" Click="MnuEffectiveEditSkill_Click" />
                                            <MenuItem x:Name="MnuEffectiveDeleteRow" Header="Delete From Tree" Click="MnuEffectiveDeleteRow_Click" />
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="" Width="44" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Width="36" Height="36" VerticalAlignment="Center" HorizontalAlignment="Center" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                                                        <Border.ToolTip>
                                                            <MultiBinding Converter="{StaticResource GameTooltipToToolTipConverter}">
                                                                <Binding Path="SkillTooltipMarkup" />
                                                                <Binding Path="SkillTooltipPlain" />
                                                            </MultiBinding>
                                                        </Border.ToolTip>
                                                        <Image Source="{Binding SkillIcon}" Width="36" Height="36" Stretch="Fill" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="ID" Binding="{Binding SkillId}" Width="70" IsReadOnly="True" ElementStyle="{StaticResource CenteredDisplayTextStyle}" EditingElementStyle="{StaticResource CenteredEditTextStyle}" />
                                        <DataGridTemplateColumn Header="Skill" Width="220" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SkillName}" Style="{StaticResource CenteredDisplayTextStyle}">
                                                        <TextBlock.ToolTip>
                                                            <MultiBinding Converter="{StaticResource GameTooltipToToolTipConverter}">
                                                                <Binding Path="SkillTooltipMarkup" />
                                                                <Binding Path="SkillTooltipPlain" />
                                                            </MultiBinding>
                                                        </TextBlock.ToolTip>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Min" Binding="{Binding MinSkillLv, UpdateSourceTrigger=PropertyChanged}" Width="55" ElementStyle="{StaticResource CenteredDisplayTextStyle}" EditingElementStyle="{StaticResource CenteredEditTextStyle}" />
                                        <DataGridTextColumn Header="Max" Binding="{Binding MaxSkillLv, UpdateSourceTrigger=PropertyChanged}" Width="55" ElementStyle="{StaticResource CenteredDisplayTextStyle}" EditingElementStyle="{StaticResource CenteredEditTextStyle}" />
                                        <DataGridTextColumn Header="Lv" Binding="{Binding Level}" Width="50" IsReadOnly="True" ElementStyle="{StaticResource CenteredDisplayTextStyle}" EditingElementStyle="{StaticResource CenteredEditTextStyle}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <TextBlock x:Name="TxtStatus" Grid.Row="2" Margin="4,10,0,0" Foreground="{DynamicResource TextMutedBrush}" />
    </Grid>
</Window>
