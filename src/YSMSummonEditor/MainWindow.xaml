<Window x:Class="YSMSummonEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mw="clr-namespace:ModernWpf.Controls;assembly=ModernWpf.Controls"
        mc:Ignorable="d"
        Title="YSM Summon Editor"
        Width="1560"
        Height="980"
        MinWidth="1240"
        MinHeight="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       FontSize="22"
                       FontWeight="Bold"
                       Text="YSM Summon Editor" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button x:Name="BtnSearch" Width="120" Height="32" Margin="0,0,8,0" Content="Search" Click="BtnSearch_Click" />
                <Button x:Name="BtnSave" Width="120" Height="32" Margin="0,0,8,0" Content="Save" Click="BtnSave_Click" />
                <Button x:Name="BtnExportDiff" Width="120" Height="32" Margin="0,0,8,0" Content="Export Diff" Click="BtnExportDiff_Click" />
                <Button x:Name="BtnSettings" Width="120" Height="32" Content="Settings" Click="BtnSettings_Click" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#474747" BorderThickness="1" CornerRadius="8" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtSearch" Height="30" Margin="0,0,8,0" VerticalContentAlignment="Center" />
                        <Button Grid.Column="1" Width="70" Height="30" Content="Go" Click="BtnSearch_Click" />
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <mw:ToggleSwitch x:Name="TglIncludeRiding" Margin="0,0,0,4" Header="Include riding-only" />
                        <mw:ToggleSwitch x:Name="TglIncludeNonForm1" Margin="0,0,0,4" Header="Include non-form1" />
                        <mw:ToggleSwitch x:Name="TglShowAllEvos" Header="Show all evolutions" />
                    </StackPanel>

                    <ListView x:Name="ListSummons" Grid.Row="2" SelectionChanged="ListSummons_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" VerticalAlignment="Center" HorizontalAlignment="Center" BorderBrush="#444" BorderThickness="1">
                                        <Image Source="{Binding Icon}" Width="36" Height="36" Stretch="Fill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Summon.SummonName}" />
                                        <TextBlock Opacity="0.8" FontSize="12" Text="{Binding Summon.SummonId}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="240" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="220" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="0,0,0,8" BorderBrush="#474747" BorderThickness="1" CornerRadius="8" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="350" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock x:Name="TxtSummonHeader" FontSize="28" FontWeight="Bold" Text="No summon selected" />
                            <TextBlock x:Name="TxtSummonMeta" Margin="0,8,0,0" />
                            <TextBlock x:Name="TxtChainInfo" Margin="0,8,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" BorderThickness="1" BorderBrush="#444" Padding="4">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <Image x:Name="ImgLarge" Stretch="None" SnapsToDevicePixels="True" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Width="180" Height="32" Margin="0,0,8,0" Content="Add Skill To Tree" Click="BtnAddTreeEntry_Click" />
                    <Button Width="220" Height="32" Margin="0,0,8,0" Content="Remove Selected Skill" Click="BtnDeleteTreeEntry_Click" />
                    <TextBlock VerticalAlignment="Center" Text="Double-click skill row to open Edit Skill" />
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,0,0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TabControl x:Name="TabStages" Grid.Row="0" SelectionChanged="TabStages_SelectionChanged" />

                    <TabControl x:Name="TabTrees" Grid.Row="1" Margin="0,8,0,0">
                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Header}" />
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate>
                                <DataGrid ItemsSource="{Binding CurrentEntries}"
                                          SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          SelectionMode="Single"
                                          IsReadOnly="False"
                                          CellEditEnding="GridTree_CellEditEnding"
                                          MouseDoubleClick="GridTree_MouseDoubleClick">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                                    <Setter Property="Background" Value="#334479ff" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Skill ID" Binding="{Binding SkillId, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                        <DataGridTextColumn Header="Skill Name" Binding="{Binding SkillName}" Width="220" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Group" Binding="{Binding SkillGroupId, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                        <DataGridTextColumn Header="Min Lv" Binding="{Binding MinSkillLv, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                        <DataGridTextColumn Header="Max Lv" Binding="{Binding MaxSkillLv, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                        <DataGridTextColumn Header="Lv" Binding="{Binding Lv, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                        <DataGridTextColumn Header="Job Lv" Binding="{Binding JobLv, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                        <DataGridTextColumn Header="Need1" Binding="{Binding NeedSkillId1, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                        <DataGridTextColumn Header="Need1 Lv" Binding="{Binding NeedSkillLv1, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                        <DataGridTextColumn Header="Need2" Binding="{Binding NeedSkillId2, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                        <DataGridTextColumn Header="Need2 Lv" Binding="{Binding NeedSkillLv2, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                        <DataGridTextColumn Header="Need3" Binding="{Binding NeedSkillId3, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                        <DataGridTextColumn Header="Need3 Lv" Binding="{Binding NeedSkillLv3, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                        <DataGridTextColumn Header="Enh Min" Binding="{Binding CEnhanceMin, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                        <DataGridTextColumn Header="Enh Max" Binding="{Binding CEnhanceMax, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>
                </Grid>

                <Border Grid.Row="3" BorderBrush="#474747" BorderThickness="1" CornerRadius="8" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock FontWeight="SemiBold" FontSize="16" Text="Effective Skills (Evo1+Evo2+Evo3)" Margin="0,0,0,8" />
                        <DataGrid x:Name="GridEffective"
                                  Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  MouseDoubleClick="GridEffective_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Stage" Binding="{Binding StageIndex}" Width="70" />
                                <DataGridTextColumn Header="Tree" Binding="{Binding TreeSlotIndex}" Width="70" />
                                <DataGridTextColumn Header="Skill ID" Binding="{Binding SkillId}" Width="90" />
                                <DataGridTextColumn Header="Skill Name" Binding="{Binding SkillName}" Width="260" />
                                <DataGridTextColumn Header="Min Lv" Binding="{Binding MinSkillLevel}" Width="80" />
                                <DataGridTextColumn Header="Max Lv" Binding="{Binding MaxSkillLevel}" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <TextBlock x:Name="TxtStatus" Grid.Row="2" Margin="4,10,0,0" />
    </Grid>
</Window>
