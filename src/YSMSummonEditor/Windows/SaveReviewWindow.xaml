<Window x:Class="YSMSummonEditor.Windows.SaveReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save Review"
        Height="600"
        Width="920"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,10"
                   FontSize="17"
                   FontWeight="SemiBold"
                   Text="Review all pending changes before commit" />

        <ListView x:Name="ListChanges" Grid.Row="1">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Type" DisplayMemberBinding="{Binding ChangeType}" Width="120" />
                    <GridViewColumn Header="Target" DisplayMemberBinding="{Binding Target}" Width="200" />
                    <GridViewColumn Header="Field" DisplayMemberBinding="{Binding Field}" Width="180" />
                    <GridViewColumn Header="Before" DisplayMemberBinding="{Binding Before}" Width="180" />
                    <GridViewColumn Header="After" DisplayMemberBinding="{Binding After}" Width="180" />
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="120" Height="34" Margin="0,10,8,0" Content="Confirm Save" Click="BtnConfirm_Click" />
            <Button Width="120" Height="34" Margin="0,10,0,0" Content="Cancel" Click="BtnCancel_Click" />
        </StackPanel>
    </Grid>
</Window>
