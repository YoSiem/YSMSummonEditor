<Window x:Class="YSMSummonEditor.Windows.DarkDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560"
        MinWidth="460"
        MinHeight="180"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBgBrush}">
    <Grid Margin="14" Background="{DynamicResource WindowBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtMessage"
                   Grid.Row="0"
                   Margin="0,0,0,12"
                   TextWrapping="Wrap"
                   FontSize="14" />

        <Expander x:Name="DetailsExpander"
                  Grid.Row="1"
                  Header="Details"
                  Visibility="Collapsed"
                  Margin="0,0,0,12">
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Background="{DynamicResource PanelBgBrush}">
                <TextBox x:Name="TxtDetails"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         MinHeight="80"
                         MaxHeight="220" />
            </Border>
        </Expander>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnTertiary" Width="92" Height="32" Margin="0,0,8,0" Visibility="Collapsed" Click="DialogButton_Click" />
            <Button x:Name="BtnSecondary" Width="92" Height="32" Margin="0,0,8,0" Visibility="Collapsed" Click="DialogButton_Click" />
            <Button x:Name="BtnPrimary" Width="92" Height="32" Visibility="Collapsed" Click="DialogButton_Click" />
        </StackPanel>
    </Grid>
</Window>
