<Window x:Class="YSMSummonEditor.Windows.RandomSkillGroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Random Skill Group"
        Width="1220"
        Height="700"
        MinWidth="1020"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}">
    <Grid Margin="12" Background="{DynamicResource WindowBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TxtHeader" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="TxtUseCode" Margin="12,2,0,0" Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>
            <TextBlock x:Name="TxtStatus" Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Skill Search">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtSearch" Height="30" VerticalContentAlignment="Center" KeyDown="TxtSearch_KeyDown" ToolTip="Contains name + exact ID. Limit 300." />
                        <Button Grid.Column="1" Width="68" Height="30" Margin="8,0,0,0" Content="Go" Click="BtnSearch_Click" />
                    </Grid>
                    <DataGrid x:Name="GridSearch"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              IsReadOnly="True"
                              MouseDoubleClick="GridSearch_MouseDoubleClick"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="44">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                                            <Border.ToolTip>
                                                <MultiBinding Converter="{StaticResource GameTooltipToToolTipConverter}">
                                                    <Binding Path="TooltipMarkup" />
                                                    <Binding Path="TooltipPlain" />
                                                </MultiBinding>
                                            </Border.ToolTip>
                                            <Image Source="{Binding Icon}" Width="36" Height="36" Stretch="Fill" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="ID" Binding="{Binding SkillId}" Width="92" />
                            <DataGridTemplateColumn Header="Skill" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SkillName}" TextTrimming="CharacterEllipsis">
                                            <TextBlock.ToolTip>
                                                <MultiBinding Converter="{StaticResource GameTooltipToToolTipConverter}">
                                                    <Binding Path="TooltipMarkup" />
                                                    <Binding Path="TooltipPlain" />
                                                </MultiBinding>
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <GroupBox Grid.Column="2" Header="Selected Skills (Random Pool)">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="GridSelected"
                              Grid.Row="0"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              IsReadOnly="True"
                              MouseDoubleClick="GridSelected_MouseDoubleClick"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="44">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                                            <Border.ToolTip>
                                                <MultiBinding Converter="{StaticResource GameTooltipToToolTipConverter}">
                                                    <Binding Path="TooltipMarkup" />
                                                    <Binding Path="TooltipPlain" />
                                                </MultiBinding>
                                            </Border.ToolTip>
                                            <Image Source="{Binding Icon}" Width="36" Height="36" Stretch="Fill" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="#" Binding="{Binding SlotIndex}" Width="48" />
                            <DataGridTextColumn Header="ID" Binding="{Binding SkillId}" Width="82" />
                            <DataGridTemplateColumn Header="Skill" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SkillName}" TextTrimming="CharacterEllipsis">
                                            <TextBlock.ToolTip>
                                                <MultiBinding Converter="{StaticResource GameTooltipToToolTipConverter}">
                                                    <Binding Path="TooltipMarkup" />
                                                    <Binding Path="TooltipPlain" />
                                                </MultiBinding>
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Width="96" Height="30" Margin="0,0,8,0" Content="Add" Click="BtnAdd_Click" />
                        <Button Width="96" Height="30" Margin="0,0,8,0" Content="Remove" Click="BtnRemove_Click" />
                        <Button Width="96" Height="30" Content="Clear" Click="BtnClear_Click" />
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="120" Height="34" Margin="0,10,8,0" Content="Apply" Click="BtnApply_Click" />
            <Button Width="120" Height="34" Margin="0,10,0,0" Content="Cancel" Click="BtnCancel_Click" />
        </StackPanel>
    </Grid>
</Window>
