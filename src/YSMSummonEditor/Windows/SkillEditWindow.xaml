<Window x:Class="YSMSummonEditor.Windows.SkillEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Skill"
        Height="700"
        Width="980"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}">
    <Window.Resources>
        <Style x:Key="DirtyDataGridRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RowDirtyBrush}" />
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RowSelectedBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GridEditTextStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="14" Background="{DynamicResource WindowBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtHeader"
                   Grid.Row="0"
                   Margin="0,0,0,10"
                   FontSize="18"
                   FontWeight="SemiBold" />

        <GroupBox Grid.Row="1" Header="Business Fields" Margin="0,0,0,10">
            <DataGrid x:Name="GridBusiness"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      IsReadOnly="False"
                      RowStyle="{StaticResource DirtyDataGridRowStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Field" Binding="{Binding Name}" IsReadOnly="True" Width="280" />
                    <DataGridTextColumn Header="Orig" Binding="{Binding OriginalValue}" IsReadOnly="True" Width="220" />
                    <DataGridTextColumn Header="Cur" Binding="{Binding CurrentValue, UpdateSourceTrigger=PropertyChanged}" Width="220" EditingElementStyle="{StaticResource GridEditTextStyle}" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Advanced Raw (Always Editable)">
            <DataGrid x:Name="GridRaw"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      IsReadOnly="False"
                      RowStyle="{StaticResource DirtyDataGridRowStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Field" Binding="{Binding Name}" IsReadOnly="True" Width="260" />
                    <DataGridTextColumn Header="Orig" Binding="{Binding OriginalValue}" IsReadOnly="True" Width="210" />
                    <DataGridTextColumn Header="Cur" Binding="{Binding CurrentValue, UpdateSourceTrigger=PropertyChanged}" Width="210" EditingElementStyle="{StaticResource GridEditTextStyle}" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="110" Height="34" Margin="0,10,8,0" Content="Apply" Click="BtnApply_Click" />
            <Button Width="110" Height="34" Margin="0,10,0,0" Content="Cancel" Click="BtnCancel_Click" />
        </StackPanel>
    </Grid>
</Window>
