<Window x:Class="YSMSummonEditor.Windows.SkillEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Skill"
        Height="700"
        Width="980"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtHeader"
                   Grid.Row="0"
                   Margin="0,0,0,10"
                   FontSize="18"
                   FontWeight="SemiBold" />

        <GroupBox Grid.Row="1" Header="Business Fields" Margin="0,0,0,10">
            <DataGrid x:Name="GridBusiness"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      IsReadOnly="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Field" Binding="{Binding Name}" IsReadOnly="True" Width="280" />
                    <DataGridTextColumn Header="Original" Binding="{Binding OriginalValue}" IsReadOnly="True" Width="220" />
                    <DataGridTextColumn Header="Current" Binding="{Binding CurrentValue, UpdateSourceTrigger=PropertyChanged}" Width="220" />
                    <DataGridCheckBoxColumn Header="Dirty" Binding="{Binding IsDirty}" IsReadOnly="True" Width="80" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Advanced Raw (Always Editable)">
            <DataGrid x:Name="GridRaw"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      IsReadOnly="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Field" Binding="{Binding Name}" IsReadOnly="True" Width="260" />
                    <DataGridTextColumn Header="Original" Binding="{Binding OriginalValue}" IsReadOnly="True" Width="210" />
                    <DataGridTextColumn Header="Current" Binding="{Binding CurrentValue, UpdateSourceTrigger=PropertyChanged}" Width="210" />
                    <DataGridCheckBoxColumn Header="Dirty" Binding="{Binding IsDirty}" IsReadOnly="True" Width="80" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="110" Height="34" Margin="0,10,8,0" Content="Apply" Click="BtnApply_Click" />
            <Button Width="110" Height="34" Margin="0,10,0,0" Content="Cancel" Click="BtnCancel_Click" />
        </StackPanel>
    </Grid>
</Window>
