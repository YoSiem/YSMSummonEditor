<Window x:Class="YSMSummonEditor.Windows.StatScalingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stat Scaling Editor"
        Width="1620"
        Height="780"
        MinWidth="1380"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}">
    <Window.Resources>
        <Style x:Key="DirtyDataGridRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RowDirtyBrush}" />
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RowSelectedBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CenteredDisplayTextStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="CenteredEditTextStyle" TargetType="TextBox">
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
    </Window.Resources>

    <Grid Margin="12" Background="{DynamicResource WindowBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtHeader"
                   Grid.Row="0"
                   Margin="0,0,0,10"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Text="Stat Scaling" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="5*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Base Stats" Margin="0,0,0,0">
                <DataGrid x:Name="GridBase"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserReorderColumns="False"
                          IsReadOnly="False"
                          SelectionMode="Single"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          RowStyle="{StaticResource DirtyDataGridRowStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Stat" Binding="{Binding StatName}" IsReadOnly="True" Width="2*" ElementStyle="{StaticResource CenteredDisplayTextStyle}" />
                        <DataGridTextColumn Header="Base Value" Binding="{Binding CurrentValue, UpdateSourceTrigger=PropertyChanged}" Width="3*" ElementStyle="{StaticResource CenteredDisplayTextStyle}" EditingElementStyle="{StaticResource CenteredEditTextStyle}" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <GroupBox Grid.Column="2" Header="CreatureLevelBonus">
                <DataGrid x:Name="GridBonus"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserReorderColumns="False"
                          IsReadOnly="False"
                          SelectionMode="Single"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          RowStyle="{StaticResource DirtyDataGridRowStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Stage" Binding="{Binding StageIndex}" IsReadOnly="True" Width="1*" ElementStyle="{StaticResource CenteredDisplayTextStyle}" />
                        <DataGridTextColumn Header="Lookup ID" Binding="{Binding LookupId}" IsReadOnly="True" Width="1.6*" ElementStyle="{StaticResource CenteredDisplayTextStyle}" />
                        <DataGridTextColumn Header="STR" Binding="{Binding Str, StringFormat=F4, UpdateSourceTrigger=PropertyChanged}" Width="1*" ElementStyle="{StaticResource CenteredDisplayTextStyle}" EditingElementStyle="{StaticResource CenteredEditTextStyle}" />
                        <DataGridTextColumn Header="VIT" Binding="{Binding Vit, StringFormat=F4, UpdateSourceTrigger=PropertyChanged}" Width="1*" ElementStyle="{StaticResource CenteredDisplayTextStyle}" EditingElementStyle="{StaticResource CenteredEditTextStyle}" />
                        <DataGridTextColumn Header="DEX" Binding="{Binding Dex, StringFormat=F4, UpdateSourceTrigger=PropertyChanged}" Width="1*" ElementStyle="{StaticResource CenteredDisplayTextStyle}" EditingElementStyle="{StaticResource CenteredEditTextStyle}" />
                        <DataGridTextColumn Header="AGI" Binding="{Binding Agi, StringFormat=F4, UpdateSourceTrigger=PropertyChanged}" Width="1*" ElementStyle="{StaticResource CenteredDisplayTextStyle}" EditingElementStyle="{StaticResource CenteredEditTextStyle}" />
                        <DataGridTextColumn Header="INT" Binding="{Binding Int, StringFormat=F4, UpdateSourceTrigger=PropertyChanged}" Width="1*" ElementStyle="{StaticResource CenteredDisplayTextStyle}" EditingElementStyle="{StaticResource CenteredEditTextStyle}" />
                        <DataGridTextColumn Header="MEN" Binding="{Binding Men, StringFormat=F4, UpdateSourceTrigger=PropertyChanged}" Width="1*" ElementStyle="{StaticResource CenteredDisplayTextStyle}" EditingElementStyle="{StaticResource CenteredEditTextStyle}" />
                        <DataGridTextColumn Header="LUK" Binding="{Binding Luk, StringFormat=F4, UpdateSourceTrigger=PropertyChanged}" Width="1*" ElementStyle="{StaticResource CenteredDisplayTextStyle}" EditingElementStyle="{StaticResource CenteredEditTextStyle}" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GridSplitter Grid.Column="3" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <GroupBox Grid.Column="4" Header="Calculator">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="Level (1..350)" />
                        <TextBox x:Name="TxtLevel" Grid.Column="1" Height="28" VerticalContentAlignment="Center" TextChanged="TxtLevel_TextChanged" />
                    </Grid>

                    <TextBlock x:Name="TxtCalcInfo" Grid.Row="1" Margin="0,0,0,8" Foreground="{DynamicResource TextMutedBrush}" />

                    <DataGrid x:Name="GridResult"
                              Grid.Row="2"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserReorderColumns="False"
                              IsReadOnly="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Stat" Binding="{Binding Stat}" Width="1*" ElementStyle="{StaticResource CenteredDisplayTextStyle}" />
                            <DataGridTextColumn Header="Base" Binding="{Binding Base}" Width="1*" ElementStyle="{StaticResource CenteredDisplayTextStyle}" />
                            <DataGridTextColumn Header="Stage1" Binding="{Binding Stage1}" Width="1.1*" ElementStyle="{StaticResource CenteredDisplayTextStyle}" />
                            <DataGridTextColumn Header="Stage2" Binding="{Binding Stage2}" Width="1.1*" ElementStyle="{StaticResource CenteredDisplayTextStyle}" />
                            <DataGridTextColumn Header="Stage3" Binding="{Binding Stage3}" Width="1.1*" ElementStyle="{StaticResource CenteredDisplayTextStyle}" />
                            <DataGridTextColumn Header="Bonus" Binding="{Binding Bonus}" Width="1.1*" ElementStyle="{StaticResource CenteredDisplayTextStyle}" />
                            <DataGridTextColumn Header="Final" Binding="{Binding Final}" Width="1.1*" ElementStyle="{StaticResource CenteredDisplayTextStyle}" />
                            <DataGridTextColumn Header="Delta" Binding="{Binding Delta}" Width="1.1*" ElementStyle="{StaticResource CenteredDisplayTextStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="120" Height="34" Margin="0,10,8,0" Content="Apply" Click="BtnApply_Click" />
            <Button Width="120" Height="34" Margin="0,10,0,0" Content="Cancel" Click="BtnCancel_Click" />
        </StackPanel>
    </Grid>
</Window>
