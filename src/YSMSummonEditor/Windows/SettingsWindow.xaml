<Window x:Class="YSMSummonEditor.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mw="clr-namespace:ModernWpf.Controls;assembly=ModernWpf.Controls"
        Title="Settings"
        Height="460"
        Width="720"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Server" Margin="0,0,12,12" />
            <TextBox x:Name="TxtServer" Grid.Row="0" Grid.Column="1" Margin="0,0,0,12" />

            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Port" Margin="0,0,12,12" />
            <TextBox x:Name="TxtPort" Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" />

            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Database" Margin="0,0,12,12" />
            <TextBox x:Name="TxtDatabase" Grid.Row="2" Grid.Column="1" Margin="0,0,0,12" />

            <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="User ID" Margin="0,0,12,12" />
            <TextBox x:Name="TxtUser" Grid.Row="3" Grid.Column="1" Margin="0,0,0,12" />

            <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="Password" Margin="0,0,12,12" />
            <PasswordBox x:Name="TxtPassword" Grid.Row="4" Grid.Column="1" Margin="0,0,0,12" />

            <TextBlock Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Text="Dump Folder" Margin="0,0,12,12" />
            <TextBox x:Name="TxtDumpFolder" Grid.Row="5" Grid.Column="1" Margin="0,0,8,12" />
            <Button x:Name="BtnBrowse" Grid.Row="5" Grid.Column="2" Content="Browse" Width="90" Height="28" Click="BtnBrowse_Click" />

            <mw:ToggleSwitch x:Name="TglTrustServerCertificate"
                             Grid.Row="6"
                             Grid.Column="1"
                             Margin="0,0,0,12"
                             Header="Trust Server Certificate" />
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="100" Height="32" Margin="0,12,8,0" Content="Save" Click="BtnSave_Click" />
            <Button Width="100" Height="32" Margin="0,12,0,0" Content="Cancel" Click="BtnCancel_Click" />
        </StackPanel>
    </Grid>
</Window>
